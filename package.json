{
  "name": "agent-observer",
  "version": "0.5.1",
  "description": "See which subagents your coding agent ran, with which model, for which task. Works with Claude Code and OpenCode out of the box.",
  "keywords": [
    "claude-code",
    "opencode",
    "claude",
    "subagents",
    "agent",
    "observability",
    "llm",
    "model-routing",
    "cli"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "bin": {
    "agent-observer": "bin/agent-observer.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core/model": "./src/core/model.js",
    "./core/report": "./src/core/report.js",
    "./adapters": "./src/adapters/index.js",
    "./server": "./opencode/plugin.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "commands/",
    "opencode/",
    ".claude-plugin/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CLAUDE.md",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "check-version": "node scripts/check-version.mjs",
    "validate-plugin": "node scripts/validate-plugin.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "verify": "pnpm run lint && pnpm run check-version && pnpm run check-docs && pnpm run validate-plugin && pnpm run test",
    "check-docs": "node scripts/check-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbecca/agent-observer.git"
  },
  "bugs": {
    "url": "https://github.com/mbecca/agent-observer/issues"
  },
  "homepage": "https://github.com/mbecca/agent-observer#readme"
}
